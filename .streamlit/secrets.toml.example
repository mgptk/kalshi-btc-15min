# Copy to .streamlit/secrets.toml for local runs (gitignored), and paste the same
# keys into the app's Secrets box on Streamlit Community Cloud.

KALSHI_API_KEY_ID = "your-api-key-id"

# Paste the whole PEM, including the BEGIN/END lines, inside triple quotes.
KALSHI_PRIVATE_KEY = """-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"""

# Optional:
# FEED_SOURCE = "sim"     # run on the offline simulator instead of live Kalshi data

# Paper-account history (P&L carried across restarts). Without these it's saved to a local
# file, which Streamlit Community Cloud wipes whenever the app sleeps, reboots or redeploys.
# PAPER_GIST_ID = "your-secret-gist-id"       # the long id at the end of the gist's URL
# GITHUB_TOKEN = "github_pat_..."             # fine-grained token with Gists: read & write
# PAPER_STATE_PATH = "data/paper_state_live.json"   # local file location (default shown)
# PAPER_PERSIST = "off"                       # disable saving entirely
